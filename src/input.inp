0           ! fresh start=0 restart =1
0           ! iteration to start from (fresh start 0 otherwise different)
3000000     ! Final time step
10000       ! Saving frequency
0.00001     ! dt for the simulation
0.0500      ! density
0.1000      ! viscosity
0.000       ! alphag
1.000       ! pr
6.283185    ! lx
2.00        ! ly
1.0         ! utop: top wall velocity (0 = no-slip fixed wall)
-1.0        ! ubot: bottom wall velocity (0 = no-slip fixed wall)
2           ! Initial condition phase-field (0=one drop, 1=read from file, 2=two drops)
0.35        ! Initial drop radius for phase-field
1.00        ! Surface tension
1.0         ! Ratio eps/dx
0.5         ! xoffset: drops at lx/2 -/+ xoffset (icphi=2)
0.25        ! yoffset: drops at ly/2 +/- yoffset (icphi=2)
0.0         ! Hamaker constant A_H for near-contact repulsive force (0 = off)
8.0         ! hc: look-ahead distance (in units of max(dx,dy)), must be > ~5.3*epsr
2.5         ! hmin: minimum gap distance (in units of max(dx,dy))
10.0        ! hmax: gap used when no other interface is detected (in units of max(dx,dy))
